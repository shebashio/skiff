#!/bin/sh
# Skiff's engine as a system service; whoever ran apt joins the skiff group
# and gets the skiff docker context.
set -e
if [ "$1" = configure ]; then
    getent group skiff >/dev/null || addgroup --system skiff
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ] && id "$SUDO_USER" >/dev/null 2>&1; then
        adduser "$SUDO_USER" skiff >/dev/null || true
        # The CLI's context, made as that person so it lands in their ~/.docker.
        su - "$SUDO_USER" -c 'docker context inspect skiff >/dev/null 2>&1 || docker context create skiff --docker host=unix:///run/skiff/docker.sock >/dev/null' || true
        su - "$SUDO_USER" -c 'docker context use skiff >/dev/null' || true
        echo "Skiff: $SUDO_USER is in the skiff group. Log out and back in once for it to apply."
    else
        echo "Skiff: add yourself to the skiff group (sudo adduser \$USER skiff), then log out and back in."
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable skiff.service >/dev/null 2>&1 || true
        systemctl restart skiff.service || true
    fi
fi
exit 0
