#!/bin/sh
# skiff.deb: after the files are gone. Images, containers and volumes stay in
# /var/lib/skiff and /var/lib/skiff-daemon unless the package is purged.
set -e
case "$1" in
  remove)
    [ -d /run/systemd/system ] && systemctl daemon-reload || true
    echo "Skiff is removed; its images, containers and volumes stay in /var/lib/skiff (apt purge skiff deletes them)"
    ;;
  purge)
    # Anything still mounted under the data directory (a container's rootfs
    # or volume from an engine that was not stopped cleanly) is unmounted
    # first, deepest first, so rm does not reach through a mount into the
    # live filesystem it came from; --one-file-system is the second guard.
    if command -v findmnt >/dev/null; then
      findmnt -lrno TARGET 2>/dev/null | grep -E "^/var/lib/skiff(/|$)" | tac | xargs -r -n1 umount 2>/dev/null || true
    fi
    rm -rf --one-file-system /var/lib/skiff /var/lib/skiff-daemon /run/skiff
    getent group skiff >/dev/null && groupdel skiff || true
    ;;
esac
exit 0
