#!/bin/sh
# skiff / skiff-lite .deb: before the files go. Stops the engine (containers it
# ran stop with it) and withdraws Skiff's docker CLI from PATH.
set -e
# Removing Skiff stops everything it runs: the engine (above, which stops its
# containers), and any window or skiff command still open from this package
# (`skiff share`, `skiff ui`), first asked to quit, then made to.
stop_everything() {
  for sig in TERM KILL; do
    pkill -"$sig" -f '^/usr/lib/skiff/skiff-window( |$)' 2>/dev/null || true
    pkill -"$sig" -f '^(/usr)?/bin/skiff( |$)' 2>/dev/null || true
    [ "$sig" = KILL ] || sleep 1
  done
}
case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl disable --now skiff.service || true
    fi
    stop_everything
    if [ -x /usr/libexec/skiff/docker ]; then
      update-alternatives --remove docker /usr/libexec/skiff/docker || true
      for p in docker-compose docker-buildx; do
        update-alternatives --remove "$p" "/usr/libexec/skiff/cli-plugins/$p" || true
      done
    fi
    ;;
esac
exit 0
