#!/bin/sh
# skiff / skiff-lite .deb: after the files are in place. Makes the `skiff` group
# the socket is shared with and, for the full package, offers its docker CLI on
# PATH through update-alternatives at a low priority: a docker CLI another
# package installed keeps winning.
set -e
# True when /usr/bin/docker is absent or already an update-alternatives link.
# A real file, or a symlink another package or the administrator put there,
# is left alone: Skiff's CLI must not take over someone else's docker.
docker_slot_free() {
  [ -e /usr/bin/docker ] || [ -L /usr/bin/docker ] || return 0
  case "$(readlink /usr/bin/docker 2>/dev/null)" in /etc/alternatives/*) return 0 ;; esac
  return 1
}
# The same for a plugin (by name) in /usr/lib/docker/cli-plugins, and taken
# also when Docker's own copy is in another of the CLI's plugin folders
# (docker-compose-plugin and docker-buildx-plugin use /usr/libexec), which
# the CLI would otherwise search after Skiff's link.
plugin_slot_free() {
  for d in /usr/local/lib/docker/cli-plugins /usr/local/libexec/docker/cli-plugins /usr/libexec/docker/cli-plugins; do
    [ -e "$d/$1" ] && return 1
  done
  l=/usr/lib/docker/cli-plugins/$1
  [ -e "$l" ] || [ -L "$l" ] || return 0
  case "$(readlink "$l" 2>/dev/null)" in /etc/alternatives/*) return 0 ;; esac
  return 1
}
# Compose and buildx into /usr/lib/docker/cli-plugins where the slot is
# free; where it isn't, Skiff's link goes (if it had one) and Docker's copy is
# used. Run on configure and again, through the file triggers, whenever
# another package adds or removes plugins in Docker's plugin folders.
link_plugins() {
  mkdir -p /usr/lib/docker/cli-plugins
  for p in docker-compose docker-buildx; do
    if plugin_slot_free "$p"; then
      update-alternatives --install "/usr/lib/docker/cli-plugins/$p" "$p" "/usr/libexec/skiff/cli-plugins/$p" 10 || true
    elif update-alternatives --list "$p" 2>/dev/null | grep -qx "/usr/libexec/skiff/cli-plugins/$p"; then
      update-alternatives --remove "$p" "/usr/libexec/skiff/cli-plugins/$p" || true
      echo "Docker's own $p is installed; Skiff's docker uses it."
    fi
  done
}
# A `skiff` that comes before /usr/bin on PATH runs instead of this package's:
# often an older Skiff from a script or manual install. Not ours to delete.
stale_skiff() {
  for d in /usr/local/sbin /usr/local/bin; do
    if [ -e "$d/skiff" ] && [ "$(readlink -f "$d/skiff")" != /usr/bin/skiff ]; then
      echo "Warning: $d/skiff comes before /usr/bin/skiff on PATH, so it runs instead of this Skiff."
      echo "  If it's an older Skiff, remove it:  sudo rm $d/skiff"
    fi
  done
}
case "$1" in
  triggered)
    [ -x /usr/libexec/skiff/docker ] && link_plugins
    ;;
  configure)
    getent group skiff >/dev/null || groupadd --system skiff
    # The engine isn't started or enabled here: it starts when someone sets
    # Skiff up (the window's Allow access, or `skiff host-access`, which runs
    # `systemctl enable --now skiff`). Installing alone runs nothing.
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      # An upgrade ($2 is the version it replaced) restarts a running engine
      # on the new binary, as the Mac and Windows apps do after an update.
      # Its containers stop; those with a restart policy start again.
      if [ -n "${2:-}" ] && systemctl is-active -q skiff.service; then
        echo "Skiff is upgraded from $2: restarting the engine on the new version."
        systemctl try-restart skiff.service || echo "  The engine didn't restart: sudo systemctl restart skiff"
      fi
    fi
    stale_skiff
    if [ -x /usr/libexec/skiff/docker ]; then
      if docker_slot_free; then
        update-alternatives --install /usr/bin/docker docker /usr/libexec/skiff/docker 10 || true
        echo "Skiff is installed with its own docker CLI (docker, docker compose, docker buildx)."
      else
        echo "Skiff is installed; /usr/bin/docker belongs to something else and stays. Skiff's CLI: /usr/libexec/skiff/docker"
      fi
      link_plugins
    else
      echo "Skiff is installed (engine only). Point a docker CLI at it:"
      echo "  docker context create skiff --docker host=unix:///run/skiff/docker.sock && docker context use skiff"
    fi
    echo "The engine starts when you set Skiff up: open Skiff, or run  sudo skiff host-access \$USER"
    echo "Members of the skiff group can run containers as root on this machine; treat it like the docker group."
    echo "While no Docker engine has /var/run/docker.sock, it leads to Skiff too (for Testcontainers, docker-py and other tools that ignore docker contexts)."
    ;;
esac
exit 0
