# Non-secret local configuration. Copy to .env.signing.local.
# Empty selects the only valid Developer ID Application identity in Keychain.
# With multiple identities, paste the intended certificate's SHA-1 fingerprint
# from: security find-identity -v -p codesigning
# Quote full names, for example:
# SKIFF_SIGN_IDENTITY='Developer ID Application: Example LLC (ABCDE12345)'
SKIFF_SIGN_IDENTITY=''
SKIFF_NOTARY_PROFILE=skiff-notary
# Optional non-secret values to prefill the interactive credential setup.
SKIFF_APPLE_ID=
SKIFF_APPLE_TEAM_ID=
